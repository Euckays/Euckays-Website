DATABASE_URL="postgresql://user:password@localhost:5432/euckays?schema=public"

# Session signing secret for the admin dashboard - generate a long random string, e.g. `openssl rand -base64 32`
ADMIN_SESSION_SECRET=""

# Seed-only: creates the first admin login (see backend/seed.ts). Change the password after first login.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Paystack (https://dashboard.paystack.com/#/settings/developer) - test keys are required to test checkout
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Product photo storage. Leave STORAGE_BUCKET empty to save uploads on local disk (development only).
# For deployment, fill these in with any S3-compatible bucket (AWS S3, Cloudflare R2, DigitalOcean Spaces, Backblaze, Supabase).
STORAGE_BUCKET=""
# AWS region, e.g. "eu-west-1". Use "auto" for Cloudflare R2.
STORAGE_REGION=""
# Leave empty for AWS S3. Other providers: their S3 endpoint, e.g. "https://<account-id>.r2.cloudflarestorage.com"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Public base URL the bucket's files are served from, e.g. "https://my-bucket.s3.eu-west-1.amazonaws.com"
STORAGE_PUBLIC_URL=""
